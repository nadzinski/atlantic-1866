{"voyage_id": "V-germania-660823-0b9b1f", "claims": [{"mark": "*", "claim": "Sailed New York (1866-08-11)", "citation": "New York Herald, 12 August 1866, p. 3, col. 4", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866081201:0623/2749,4493,948,314/640,/0/default.jpg", "verbatim": "Germania,", "lineage_id": "herald:Lf5b45013e3ae107b", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-08-12/ed-1/seq-3/"}, {"mark": "†", "claim": "Departed New York (11 Aug)", "citation": "Hubbard & Winter, North Atlantic Mail Sailings 1840-75 (USPCS, 1988; rev. 2014), p. 179", "source_kind": "compiled", "displayable": false, "crop": null, "verbatim": null, "lineage_id": "hw:hapag-189-062-e:0", "source": "hw"}, {"mark": "‡", "claim": "Arrived Southampton (to-day)", "citation": "New York Herald, 25 August 1866, p. 1, col. 3", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866082501:0727/2003,1927,941,120/640,/0/default.jpg", "verbatim": "The steamship Germania from New York arrived at\nthis port to-day.", "lineage_id": "herald:L0e0b3736c3fa9ad6", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-08-25/ed-1/seq-1/"}, {"mark": "§", "claim": "Arrived Southampton (23 Aug)", "citation": "Hubbard & Winter, North Atlantic Mail Sailings 1840-75 (USPCS, 1988; rev. 2014), p. 179", "source_kind": "compiled", "displayable": false, "crop": null, "verbatim": null, "lineage_id": "hw:hapag-189-062-e:1", "source": "hw"}, {"mark": "‖", "claim": "Arrived Southampton (to-day)", "citation": "The Sun (New York), 25 August 1866, p. 1, col. 3", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:nn:batch_nn_brown_ver01:data:sn83030272:0020653607A:1866082501:0809/1387,1970,704,375/640,/0/default.jpg", "verbatim": "SOUTHAMPTON, AUG. 23.—The steamship German-\nia from New York, arrived at this port to-day.", "lineage_id": "sun:L2042f03e64ee332e", "source": "sun", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030272/1866-08-25/ed-1/seq-1/"}, {"mark": "¶", "claim": "Arrived Cowes (23)", "citation": "Lloyd's List, 23 August 1866, p. 1, col. 2 (British Newspaper Archive)", "source_kind": "newspaper", "displayable": false, "crop": null, "verbatim": null, "lineage_id": "lloyds:Lfc8ded6a79e23fd4", "source": "lloyds", "url": null}, {"mark": "7", "claim": "Arrived Hamburg (25 Aug)", "citation": "Hubbard & Winter, North Atlantic Mail Sailings 1840-75 (USPCS, 1988; rev. 2014), p. 179", "source_kind": "compiled", "displayable": false, "crop": null, "verbatim": null, "lineage_id": "hw:hapag-189-062-e:2", "source": "hw"}, {"mark": "8", "claim": "Arrived Hamburg (1866-08-25)", "citation": "Lloyd's List, 29 August 1866, p. 6, col. 1 (British Newspaper Archive)", "source_kind": "newspaper", "displayable": false, "crop": null, "verbatim": null, "lineage_id": "lloyds:L10c167da1794a2da", "source": "lloyds", "url": null}, {"mark": "9", "claim": "Arrived Hamburg (1866-08-26)", "citation": "Lloyd's List, 29 August 1866, p. 6, col. 1 (British Newspaper Archive)", "source_kind": "newspaper", "displayable": false, "crop": null, "verbatim": null, "lineage_id": "lloyds:Lb1d1ce075fc24e8d", "source": "lloyds", "url": null}, {"mark": "10", "claim": "Arrived Cuxhaven (1866-08-25)", "citation": "New York Herald, 11 September 1866, p. 9, col. 1", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866091101:0893/92,1228,971,336/640,/0/default.jpg", "verbatim": "CUXHAVEN, Aug 26—Arr Germania (s), Ehlers, NYork.", "lineage_id": "herald:L698d24957e496791", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-09-11/ed-1/seq-9/"}, {"mark": "11", "claim": "Spoken / sighted lat. 42 15, long. 53 12 (13th)", "citation": "New-York Tribune, 16 August 1866, p. 3, col. 6", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_delphi_ver03:data:sn83030214:00206530832:1866081601:0741/4994,5216,1034,848/640,/0/default.jpg", "verbatim": "Steamship Bavaria (Hamb.), Taube, Hamburg July 28 via South-\nampton Aug. 2, with mdse. and 278 pass. to Kunhardt & Co. Aug. 3,\nlat. 49 41, long. 11, saw American ship Nerius[?] bound E; 7th, lat. 48[?] 40,\nlong. 30 10, bark H. Palmer (Br.), bound W; 12th, lat. 44, long. 58,\nship John DeWolf (Br.), bound W; same day, lat. 42 30[?], long 62,\nsteamship Ville de Paris; 13th, lat. 42 15, long. 53 12, Hamb. steamship\nGermania, steamship City of Boston (Br.), steamship Hansa (Brem.),\nand steamship Caledonia (Br.); 14th inst., passed pilot boat David\nMitchell with a dismasted brig in tow, making for Newport. The B.\nhas had five deaths from cholera on the passage, and there are at pres-\nent four cases of the same disease on board. The vessel has been\nsent to the Lower Quarantine.", "lineage_id": "tribune:L6506a5d5c5a1c7ee", "source": "tribune", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030214/1866-08-16/ed-1/seq-3/"}, {"mark": "12", "claim": "Cleared New York (1866-08-10)", "citation": "New York Herald, 11 August 1866, p. 3, col. 1", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866081101:0615/185,6810,934,363/640,/0/default.jpg", "verbatim": "Steamship Germania (Ham), Ehlers, Southampton and\nHamburg—Kunhardt & Co.", "lineage_id": "herald:L1ff1809c6d894ce7", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-08-11/ed-1/seq-3/"}, {"mark": "13", "claim": "Cleared New York (1866-08-10)", "citation": "The Sun (New York), 11 August 1866, p. 4, col. 3", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:nn:batch_nn_brown_ver01:data:sn83030272:0020653607A:1866081101:0764/1439,138,707,320/640,/0/default.jpg", "verbatim": "Germania, Ham-\nburg", "lineage_id": "sun:L4800d01457a898a5", "source": "sun", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030272/1866-08-11/ed-1/seq-4/"}, {"mark": "14", "claim": "Cleared New York (1866-08-10)", "citation": "New-York Tribune, 11 August 1866, p. 3, col. 6", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_delphi_ver03:data:sn83030214:00206530832:1866081101:0709/5047,4096,1016,120/640,/0/default.jpg", "verbatim": "Steamship Germania (Hamb.), Ehlers, Hamburg, Kunhardt & Co.", "lineage_id": "tribune:L9e8b5ff61ad5fa98", "source": "tribune", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030214/1866-08-11/ed-1/seq-3/"}, {"mark": "15", "claim": "Specie $3,000", "citation": "New York Herald, 12 August 1866, p. 2, col. 1", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-08-12/ed-1/seq-2/", "source_kind": "newspaper", "displayable": true, "crop": null, "verbatim": "The shipment of specie by this day's steamers aggregated\n$86,175, of which the Ville de Paris took $58,000, the\nGermania $3,000, the City of Boston $15,175, and the\nHelvetia $10,000, making for the week $152,375.", "lineage_id": "herald:Lcab7b077f17dbd5d", "source": "herald"}], "aboard": {"specie": [{"text": "$3,000", "marks": ["15"]}], "passengers": [], "mails": [], "headlines": [], "mail": []}}