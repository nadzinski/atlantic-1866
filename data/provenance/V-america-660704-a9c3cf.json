{"voyage_id": "V-america-660704-a9c3cf", "claims": [{"mark": "*", "claim": "Cleared Saint John (1866-07-04)", "citation": "New York Herald, 12 July 1866, p. 5, col. 6", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866071201:0357/4635,7641,989,327/640,/0/default.jpg", "verbatim": "America, Mortimer, Liverpool.", "lineage_id": "herald:L9b4528ca9974ec17", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-07-12/ed-1/seq-5/"}, {"mark": "†", "claim": "Brought news from Liverpool, to 1866-07-03", "citation": "The Sun (New York), 16 July 1866, p. 1, col. 3", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030272/1866-07-16/ed-1/seq-1/", "source_kind": "newspaper", "displayable": true, "crop": null, "verbatim": "Latest Commercial Per America.", "lineage_id": "sun:Lafab9d51c91df1d1", "source": "sun"}, {"mark": "‡", "claim": "Brought news from Europe, to 1866-07-04", "citation": "New York Herald, 16 July 1866, p. 2, col. 1", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-07-16/ed-1/seq-2/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866071601:0392/159,1574,963,161/640,/0/default.jpg", "verbatim": "By the America, at this port yesterday, we received\nour European files to the 4th of July. The papers con-\ntain the following general news reports.", "lineage_id": "herald:Ldfe1b002406326d1", "source": "herald"}, {"mark": "§", "claim": "Brought news from Europe, to 1866-07-06", "citation": "New York Herald, 16 July 1866, p. 4, col. 2", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-07-16/ed-1/seq-4/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866071601:0394/1063,295,940,213/640,/0/default.jpg", "verbatim": "The European news received yesterday by\nthe America at this port, and the Nova Scotian\noff Father Point, is dated to the 6th of July,", "lineage_id": "herald:L259487c87c8581e0", "source": "herald"}, {"mark": "‖", "claim": "Brought news from Europe, to 1866-07-06", "citation": "New York Herald, 16 July 1866, p. 4, col. 1", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-07-16/ed-1/seq-4/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866071601:0394/125,1741,972,159/640,/0/default.jpg", "verbatim": "By the arrival of the steamships America at this port\nand Nova Scotian at Father Point yesterday we have\nnews from Europe to the 6th of July, five days later.", "lineage_id": "herald:L3d7004ec8c7d1548", "source": "herald"}], "aboard": {"specie": [], "passengers": [], "mails": [], "headlines": [{"text": "AFFAIRS IN EUROPE.", "dates_to": "1866-07-04", "marks": ["‡"]}, {"text": "Highly Important from Europe.", "dates_to": "1866-07-06", "marks": ["§"]}], "mail": []}}