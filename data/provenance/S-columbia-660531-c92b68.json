"verbatim": "bark Columbia, Roberts, Trapani;", "lineage_id": "herald:Lf25048612d6da039", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-06-04/ed-1/seq-5/"}, {"mark": "‖", "claim": "Brought news from Havana, to 1866-05-05", "citation": "New York Herald, 10 May 1866, p. 4, col. 5", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-05-10/ed-1/seq-4/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_goldenglow_ver01:data:sn83030313:00271743543:1866051001:1166/3840,1732,971,198/640,/0/default.jpg", "verbatim": "The steamship Columbia, Captain Barton, from Havana\non the 5th inst., arrived at this port yesterday. We are\nunder obligations to the purser of the Columbia for the\nprompt delivery of our files and despatches.", "lineage_id": "herald:Leac5b0efc1498185", "source": "herald"}, {"mark": "¶", "claim": "Brought news from Havana, to 1866-05-26", "citation": "New York Herald, 31 May 1866, p. 1, col. 6", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-05-31/ed-1/seq-1/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_goldenglow_ver01:data:sn83030313:00271743543:1866053101:1375/4680,2024,968,200/640,/0/default.jpg", "verbatim": "The steamship Columbia, Captain Barton, from Havana\non the 26th of May, arrived at this port yesterday. Our[?]\nthanks are due to the purser of the Columbia for the\nprompt delivery of our files and despatches.", "lineage_id": "herald:L35387b1871c4978e", "source": "herald"}], "aboard": {"specie": [], "passengers": [], "mails": [], "headlines": [{"text": "CUBA.", "dates_to": "1866-05-05", "marks": ["‖", "¶"]}], "mail": []}}