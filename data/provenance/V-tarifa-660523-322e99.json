{"voyage_id": "V-tarifa-660523-322e99", "claims": [{"mark": "*", "claim": "Arrived Queenstown (3)", "citation": "Lloyd's List, 4 June 1866, p. 2, col. 3 (British Newspaper Archive)", "source_kind": "newspaper", "displayable": false, "crop": null, "verbatim": null, "lineage_id": "lloyds:Lee5e344092507b04", "source": "lloyds", "url": null}, {"mark": "†", "claim": "Arrived Liverpool (4th)", "citation": "New York Herald, 17 June 1866, p. 2, col. 5", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866061701:0146/3849,7037,962,326/640,/0/default.jpg", "verbatim": "4th, Tarifa (s),\nLangland, do;", "lineage_id": "herald:L928e0e63b585c6bf", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-06-17/ed-1/seq-2/"}, {"mark": "‡", "claim": "Arrived Liverpool (the 4th of\nJune)", "citation": "New York Herald, 17 June 1866, p. 1, col. 1", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866061701:0145/8,6133,963,199/640,/0/default.jpg", "verbatim": "The Pennsylvania reached Liverpool on the morning\nof[?] the 3d, and the Tarifa on the evening of the 4th of\nJune.", "lineage_id": "herald:Lfac439af4af1ec77", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-06-17/ed-1/seq-1/"}, {"mark": "§", "claim": "Spoken / sighted lat 41 N, lon 70 W (25th)", "citation": "New York Herald, 27 May 1866, p. 8, col. 4", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_goldenglow_ver01:data:sn83030313:00271743543:1866052701:1348/3012,4197,972,258/640,/0/default.jpg", "verbatim": "Steamship Saxonia (Ham), Meier, Hamburg May 13, at 7\nAM, via Southampton 15th, at 10:25 PM, with mdse and 841[?]\npassengers, to Kunhardt & Co. May 13, near Cuxhaven,\npassed the steamship Humboldt (Ham), bound E; 14th, near\nDungeness, the bark Chance (Ham), bound W; also brig Carl\n(Ham), bound W; 15th, at 9:30[?] PM, steamship Herman\n(Brem); 24th, lat 41 22 N, lon 63 36 W, the ship Admiral\n(Brem) bound W; 25th, lat 41 N, lon 70 W, steamship Tarifa;\n25th, lat 40 50 N, lon 70 W, steamship Emerson.", "lineage_id": "herald:L3ec8ea8239b0f917", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-05-27/ed-1/seq-8/"}, {"mark": "‖", "claim": "Spoken / sighted Queenstown off Queenstown (3d)", "citation": "New-York Tribune, 12 June 1866, p. 8, col. 6", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_delphi_ver03:data:sn83030214:00206530832:1866061201:0302/5077,2166,1026,245/640,/0/default.jpg", "verbatim": "Steamship Scotia (Br.), Judkins, Liverpool 2d, via Queenstown 3d[?]\ninst., 8:40 p. m., with mdse. and pass. to E. Cunard. 2d inst., off\nCrosby Lightship, passed ship Jeremiah Thompson, hence, bound in;\n3d, off Queenstown, steamship Tarifa, bound in; 4th, lat. 51 08, long.\n14 55, steamship City of New-York, hence for Liverpool; 5th, lat. 50\n48, long. 21 40, a National Co.'s steamer, bound E; same day, steam-\nship City of Limerick, hence for Liverpool; 6th, lat. 48 44, long. 32 53,\na steamer, supposed the Tripoli, hence for Liverpool.", "lineage_id": "tribune:L0cfae701fbd5cf17", "source": "tribune", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030214/1866-06-12/ed-1/seq-8/"}, {"mark": "¶", "claim": "In port Liverpool (5th)", "citation": "New York Herald, 22 June 1866, p. 2, col. 5", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866062201:0186/3872,6332,939,334/640,/0/default.jpg", "verbatim": "Ent out 5th, Tarifa (s), Langlands, NYork;", "lineage_id": "herald:L95b0