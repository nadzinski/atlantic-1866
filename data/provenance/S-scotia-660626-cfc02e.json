{"voyage_id": "S-scotia-660626-cfc02e", "claims": [{"mark": "*", "claim": "Arrived Boston (26th)", "citation": "New York Herald, 27 June 1866, p. 8, col. 6", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866062701:0232/4916,1897,946,319/640,/0/default.jpg", "verbatim": "ship Scotia,\nLeghorn;", "lineage_id": "herald:L9d6f8d42ac0ee508", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-06-27/ed-1/seq-8/"}, {"mark": "†", "claim": "Brought news from Queenstown, to 1866-04-22", "citation": "The Sun (New York), 2 May 1866, p. 1, col. 4", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030272/1866-05-02/ed-1/seq-1/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:nn:batch_nn_brown_ver01:data:sn83030272:0020653607A:1866050201:0417/2046,4333,699,120/640,/0/default.jpg", "verbatim": "The Cunard steamship Scotia from Queenstown\nthe 22d of April has arrived. Among her passengers\nis Mr. George Peabody.", "lineage_id": "sun:L76f1fedffedffc97", "source": "sun"}, {"mark": "‡", "claim": "Brought news from Liverpool, to 2026-04-22", "citation": "Evening Star (Washington), 1 May 1866, p. 4, col. 5", "url": "https://chroniclingamerica.loc.gov/lccn/sn83045462/1866-05-01/ed-1/seq-4/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_leonberger_ver03:data:sn83045462:00280654267:1866050101:0010/3958,833,1068,154/640,/0/default.jpg", "verbatim": "George Peabody, Esq., is among the passen-\ngers by the Scotia. He was warmly cheered\non embarking at Liverpool.", "lineage_id": "star:Lb2cf9f3bdbdd4274", "source": "star"}, {"mark": "§", "claim": "Brought news from Liverpool, to 1866-04-21", "citation": "Evening Star (Washington), 1 May 1866, p. 4, col. 4", "url": "https://chroniclingamerica.loc.gov/lccn/sn83045462/1866-05-01/ed-1/seq-4/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_leonberger_ver03:data:sn83045462:00280654267:1866050101:0010/2987,7055,1039,167/640,/0/default.jpg", "verbatim": "NEW YORK, May 1.—The steamship Scotia\nhas arrived with Liverpool dates to the 21st\nult., via Queenstown on the 22d.", "lineage_id": "star:L26a2939f62f7f882", "source": "star"}, {"mark": "‖", "claim": "Brought news from Liverpool, to 1866-04-21", "citation": "Evening Star (Washington), 1 May 1866, p. 4, col. 4", "url": "https://chroniclingamerica.loc.gov/lccn/sn83045462/1866-05-01/ed-1/seq-4/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_leonberger_ver03:data:sn83045462:00280654267:1866050101:0010/2987,7055,1039,167/640,/0/default.jpg", "verbatim": "NEW YORK, May 1.—The steamship Scotia\nhas arrived with Liverpool dates to the 21st\nult., via Queenstown on the 22d.", "lineage_id": "star:Lda5293e1bdf8151b", "source": "star"}, {"mark": "¶", "claim": "Brought news from Europe, to 1866-06-03", "citation": "New York Herald, 12 June 1866, p. 4, col. 5", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-06-12/ed-1/seq-4/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866061201:0108/3797,1572,960,201/640,/0/default.jpg", "verbatim": "The royal mail steamship Scotia, Captain Judkins,\nwhich left Liverpool at 11 o'clock on the morning of the\n2d, and Queenstown on the evening of the 3d of June,\narrived here early this morning.", "lineage_id": "herald:L80133ea6c88d9d40", "source": "herald"}, {"mark": "7", "claim": "Brought news from Europe, to 1866-06-02", "citation": "New York Herald, 13 June 1866, p. 8, col. 1", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-06-13/ed-1/seq-8/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866061301:0120/352,1582,969,162/640,/0/default.jpg", "verbatim": "The steamship Scotia, at this port early yesterday\nmorning[?], brought European advices, with our files and\nspecial[?] correspondence, dated to the 2d of June.", "lineage_id": "herald:L6fdb75a6a077c691", "source": "herald"}, {"mark": "8", "claim": "Brought news from Liverpool, to 1866-06-02", "citation": "Evening Star (Washington), 12 June 1866, p. 4, col. 4", "url": "https://chroniclingamerica.loc.gov/lccn/sn83045462/1866-06-12/ed-1/seq-4/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_leonberger_ver03:data:sn83045462:00280654267:1866061201:0179/3037,7925,1039,167/640,/0/default.jpg", "verbatim": "NEW YORK. June 12.—The steamer Scotia,\nfrom Liverpool on the 2d, via Queenstown on\nthe 3d, has arrived.", "lineage_id": "star:L3c8e8441d98bf7c0", "source": "star"}], "aboard": {"specie": [], "passengers": [], "mails": [], "headlines": [{"text": "From Europe. Four Days' Later News.", "dates_to": "1866-04-22", "marks": ["†"]}, {"text": "LATER FROM EUROPE. Arrival of the Scotia", "dates_to": "1866-04-21", "marks": ["§"]}, {"text": "LATER FROM EUROPE", "dates_to": "1866-04-21", "marks": ["‖", "8"]}], "mail": []}}