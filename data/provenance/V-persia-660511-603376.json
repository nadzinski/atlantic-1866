{"voyage_id": "V-persia-660511-603376", "claims": [{"mark": "*", "claim": "Cleared New Orleans (1866-05-11)", "citation": "New York Herald, 18 May 1866, p. 8, col. 6", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_goldenglow_ver01:data:sn83030313:00271743543:1866051801:1258/4899,1455,969,120/640,/0/default.jpg", "verbatim": "ship Persia, Doane, Liverpool;", "lineage_id": "herald:Le14d9ce22e589b5a", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-05-18/ed-1/seq-8/"}, {"mark": "†", "claim": "Brought news from Europe, to 1866-05-20", "citation": "New York Herald, 30 May 1866, p. 4, col. 1", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-05-30/ed-1/seq-4/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_goldenglow_ver01:data:sn83030313:00271743543:1866053001:1370/277,2308,968,164/640,/0/default.jpg", "verbatim": "By the arrival yesterday of the steamships St. David\noff Father Point and Persia at this port we have news\nfrom Europe to the 20th of May, three days later.", "lineage_id": "herald:L95254b5aa08409be", "source": "herald"}, {"mark": "‡", "claim": "Brought news from Liverpool, to 1866-05-20", "citation": "New York Herald, 30 May 1866, p. 8, col. 1", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-05-30/ed-1/seq-8/", "source_kind": "newspaper", "displayable": true, "crop": null, "verbatim": "The Cunard steamship Persia, Captain Lott, which left\nLiverpool at eleven o'clock on the morning of the 19th\nand Queenstown on the evening of the 20th of May,\narrived at this port yesterday evening.", "lineage_id": "herald:Lfcfc4c69726815be", "source": "herald"}], "aboard": {"specie": [], "passengers": [], "mails": [], "headlines": [], "mail": []}}