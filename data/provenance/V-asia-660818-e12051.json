: "herald:Lb0da7f02f41d33e5", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-08-30/ed-1/seq-9/"}, {"mark": "¶", "claim": "Arrived Halifax (1866-08-29)", "citation": "Evening Star (Washington), 29 August 1866, p. 2, col. 5", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_leonberger_ver03:data:sn83045462:00280654279:1866082901:0257/4066,3174,1053,146/640,/0/default.jpg", "verbatim": "HALIFAX, Aug. 29.—The steamship Asia has\narrived with dates to the 19th inst. Her news\nhas been anticipated.", "lineage_id": "star:Ld7376e629ad9e6fb", "source": "star", "url": "https://chroniclingamerica.loc.gov/lccn/sn83045462/1866-08-29/ed-1/seq-2/"}, {"mark": "7", "claim": "Arrived Halifax (Aug. 29)", "citation": "The Sun (New York), 30 August 1866, p. 4, col. 3", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:nn:batch_nn_brown_ver01:data:sn83030272:0020653607A:1866083001:0828/1517,2195,715,399/640,/0/default.jpg", "verbatim": "HALIFAX, Aug. 29.—The steamship Asia, from\nLiverpool the 18th, via Queenstown the 19th, has\narrived at this port en route for Boston.", "lineage_id": "sun:L4f117f5806a2ab08", "source": "sun", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030272/1866-08-30/ed-1/seq-4/"}, {"mark": "8", "claim": "Arrived Boston (31st)", "citation": "New York Herald, 2 September 1866, p. 2, col. 5", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866090201:0798/3792,1150,962,120/640,/0/default.jpg", "verbatim": "31st—Arr steamships Asia, Anderson, Liverpool", "lineage_id": "herald:L7da2210126cf16d5", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-09-02/ed-1/seq-2/"}, {"mark": "9", "claim": "Arrived Boston (31 Aug(B))", "citation": "Hubbard & Winter, North Atlantic Mail Sailings 1840-75 (USPCS, 1988; rev. 2014), p. 54", "source_kind": "compiled", "displayable": false, "crop": null, "verbatim": null, "lineage_id": "hw:cunard-64-056-w:2", "source": "hw"}, {"mark": "10", "claim": "Brought news, to 1866-08-19", "citation": "New York Herald, 30 August 1866, p. 6, col. 1", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-08-30/ed-1/seq-6/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866083001:0776/239,3167,965,120/640,/0/default.jpg", "verbatim": "By the steamship Asia at Halifax, yesterday, we have\nmail advices to the 19th of August.", "lineage_id": "herald:Lc27690547f5782e7", "source": "herald"}, {"mark": "11", "claim": "Brought news from Europe, to 1866-08-19", "citation": "The Sun (New York), 30 August 1866, p. 4, col. 3", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030272/1866-08-30/ed-1/seq-4/", "source_kind": "newspaper", "displayable": true, "crop": null, "verbatim": "HALIFAX, Aug. 29.—The steamship Asia, from\nLiverpool the 18th, via Queenstown the 19th, has\narrived at this port en route for Boston.", "lineage_id": "sun:L09df8ea4de546915", "source": "sun"}, {"mark": "12", "claim": "Brought news, to 1866-08-19", "citation": "Evening Star (Washington), 29 August 1866, p. 2, col. 5", "url": "https://chroniclingamerica.loc.gov/lccn/sn83045462/1866-08-29/ed-1/seq-2/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_leonberger_ver03:data:sn83045462:00280654279:1866082901:0257/4066,3174,1053,146/640,/0/default.jpg", "verbatim": "HALIFAX, Aug. 29.—The steamship Asia has\narrived with dates to the 19th inst. Her news\nhas been anticipated.", "lineage_id": "star:L1a681ede345d7bc7", "source": "star"}, {"mark": "13", "claim": "Brought news, to 1866-08-18", "citation": "New York Herald, 1 September 1866, p. 4, col. 1", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-09-01/ed-1/seq-4/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866090101:0792/221,3344,936,238/640,/0/default.jpg", "verbatim": "Our special European correspondence and newspaper\nfiles, dated to the 18th of August, by the Asia, reached\nthis city from Boston yesterday evening, furnishing the\ndetails of our advices telegraphed from Halifax, and\npublished in the HERALD on Thursday.", "lineage_id": "herald:L9cd0e9a9b42360e7", "source": "herald"}, {"mark": "14", "claim": "Brought news, to 1866-08-18", "citation": "The Sun (New York), 1 September 1866, p. 1, col. 4", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030272/1866-09-01/ed-1/seq-1/", "source_kind": "newspaper", "displayable": true, "crop": null, "verbatim": "The steamship Asia arrived at this port yesterda[cut]\nwith newspaper mails to the 18th inst. The follo[cut]\ning extracts are interesting:", "lineage_id": "sun:L5c7aebcbf0de4e03", "source": "sun"}], "aboard": {"specie": [], "passengers": [], "mails": [], "headlines": [{"text": "FOREIGN NEWS BY STEAMER. Dates to August 19th.", "dates_to": "1866-08-19", "marks": ["11"]}, {"text": "FOREIGN NEWS BY STEAMER.", "dates_to": "1866-08-18", "marks": ["14"]}], "mail": []}}