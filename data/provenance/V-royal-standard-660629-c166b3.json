{"voyage_id": "V-royal-standard-660629-c166b3", "claims": [{"mark": "*", "claim": "Sailed New York (1866-06-30)", "citation": "New York Herald, 1 July 1866, p. 3, col. 2", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866070101:0261/1056,2426,958,316/640,/0/default.jpg", "verbatim": "Royal Standard", "lineage_id": "herald:Ld5f7628acac427d2", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-07-01/ed-1/seq-3/"}, {"mark": "†", "claim": "Arrived Liverpool (17th)", "citation": "New York Herald, 30 July 1866, p. 3, col. 4", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866073001:0513/2756,3812,949,326/640,/0/default.jpg", "verbatim": "17th, Royal Standard, NYork;", "lineage_id": "herald:L31c54871903a6f22", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-07-30/ed-1/seq-3/"}, {"mark": "‡", "claim": "Spoken / sighted lat 40 16, lon 69 16 (July 2)", "citation": "New York Herald, 8 July 1866, p. 8, col. 5", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866070801:0326/3796,2400,959,546/640,/0/default.jpg", "verbatim": "Ship Glad Tidings, Thomson, Cardiff, 36 days, with railway\niron, to Wm & Alfred Nelson. Had light westerly winds and\nfogs the whole passage. June 16, lat 46 34, lon 48 18, at noon,\npassed close to a very large iceberg; 19th, lat 44 20, lon 49 30,\npassed an iceberg and saw several seals; July 2, lat 40 16, lon\n69 16, saw steamship Royal Standard, hence for Liverpool.", "lineage_id": "herald:Ld15d254040e54023", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-07-08/ed-1/seq-8/"}, {"mark": "§", "claim": "Spoken / sighted lat 40 25, lon 67 47 (July 2)", "citation": "New York Herald, 7 July 1866, p. 2, col. 6", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866070701:0312/4609,6738,960,406/640,/0/default.jpg", "verbatim": "Bark Rescue (Br), Thompson, Cette, 63 days, with wine,\n&c, to order. July 2, lat 40 25, lon 67 47, saw steamship Royal\nStandard (Br), from New York for Liverpool.", "lineage_id": "herald:Lf790d0ec52906296", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-07-07/ed-1/seq-2/"}, {"mark": "‖", "claim": "Spoken / sighted 50 N 12 W (14th July)", "citation": "Lloyd's List, 20 July 1866, p. 4, col. 3 (British Newspaper Archive)", "source_kind": "newspaper", "displayable": false, "crop": null, "verbatim": null, "lineage_id": "lloyds:Lfde7a73c27d546c7", "source": "lloyds", "url": null}, {"mark": "¶", "claim": "Cleared New York (1866-06-29)", "citation": "New York Herald, 30 June 1866, p. 2, col. 5", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866063001:0252/3989,6087,945,360/640,/0/default.jpg", "verbatim": "Steamship Royal Standard (Br), Whimsay[?], Liverpool—\nWilliams & Guion.", "lineage_id": "herald:Lc40b0a6c2317b6d3", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-06-30/ed-1/seq-2/"}, {"mark": "7", "claim": "Cleared New York (1866-06-29)", "citation": "The Sun (New York), 30 June 1866, p. 4, col. 3", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:nn:batch_nn_brown_ver01:data:sn83030272:0020653607A:1866063001:0624/1397,294,702,324/640,/0/default.jpg", "verbatim": "Royal Standard, Liverpool", "lineage_id": "sun:La740c7277c958f4c", "source": "sun", "url": "ht