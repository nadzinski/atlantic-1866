{"voyage_id": "V-moravian-660906-1273f9", "claims": [{"mark": "*", "claim": "Departed Southampton (to-day)", "citation": "Evening Star (Washington), 7 September 1866, p. 2, col. 2", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_leonberger_ver03:data:sn83045462:00280654279:1866090701:0289/1144,1799,1047,220/640,/0/default.jpg", "verbatim": "SOUTHAMPTON, Sept. 6.—The Moravian\nsailed[?] to-day for Quebec[?]. She took over three\nhundred British regulars for service in\nCanada.", "lineage_id": "star:Lcc45aa64d6a8cf45", "source": "star", "url": "https://chroniclingamerica.loc.gov/lccn/sn83045462/1866-09-07/ed-1/seq-2/"}, {"mark": "†", "claim": "Sailed Liverpool (LivisPoOL,\nTHUBSDAY.—To-clay)", "citation": "The Express (London), 7 September 1866, “INSURRECTION IN CANDIA”, HMD item art0006 (Heritage Made Digital, British Library)", "source_kind": "newspaper", "displayable": false, "crop": null, "verbatim": null, "lineage_id": "hmd:L401a4935524c1f2c", "source": "hmd", "url": "https://doi.org/10.5281/zenodo.15056046"}, {"mark": "‡", "claim": "Departed Liverpool (6 Sep)", "citation": "Hubbard & Winter, North Atlantic Mail Sailings 1840-75 (USPCS, 1988; rev. 2014), p. 147", "source_kind": "compiled", "displayable": false, "crop": null, "verbatim": null, "lineage_id": "hw:allan-157-083-w:0", "source": "hw"}, {"mark": "§", "claim": "Departed Liverpool (on the 6th)", "citation": "Evening Star (Washington), 17 September 1866, p. 2, col. 2", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_leonberger_ver03:data:sn83045462:00280654279:1866091701:0321/1140,1422,1044,419/640,/0/default.jpg", "verbatim": "The steamer Mo-\nravian, from Liverpool on the 6th, via Lon-\ndonderry on the 7th, passed this point to-day.", "lineage_id": "star:Lddc6fbf37c47e11b", "source": "star", "url": "https://chroniclingamerica.loc.gov/lccn/sn83045462/