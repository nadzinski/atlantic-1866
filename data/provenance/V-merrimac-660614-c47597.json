{"voyage_id": "V-merrimac-660614-c47597", "claims": [{"mark": "*", "claim": "Departed Bremen (June 14)", "citation": "New York Herald, 3 July 1866, p. 3, col. 1", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866070301:0277/219,5530,972,434/640,/0/default.jpg", "verbatim": "The North American Lloyd's steamship Merrimac,\nCaptain Van Lice[?], from Bremen June 14, and Southamp-\nton 18, arrived at this port yesterday afternoon.", "lineage_id": "herald:L2a741b714ab3e4db", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-07-03/ed-1/seq-3/"}, {"mark": "†", "claim": "Departed Bremen (June 14)", "citation": "New-York Tribune, 3 July 1866, p. 6, col. 5", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_delphi_ver03:data:sn83030214:00206530832:1866070301:0444/4039,7192,1039,120/640,/0/default.jpg", "verbatim": "Steamship Merrimack, Van Sice, Bremen June 14, and Southamp-\nton 18th, with mdse. and 318 pass. to Ruger Bros.", "lineage_id": "tribune:Lafa91e6240e8753e", "source": "tribune", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030214/1866-07-03/ed-1/seq-6/"}, {"mark": "‡", "claim": "Departed Bremerhaven (14 Jun)", "citation": "Hubbard & Winter, North Atlantic Mail Sailings 1840-75 (USPCS, 1988; rev. 2014), p. 292", "source_kind": "compiled", "displayable": false, "crop": null, "verbatim": null, "lineage_id": "hw:nal-302-006-w:0", "source": "hw"}, {"mark": "§", "claim": "Departed Southampton (18 Jun)", "citation": "Hubbard & Winter, North Atlantic Mail Sailings 1840-75 (USPCS, 1988; rev. 2014), p. 292", "source_kind": "compiled", "displayable": false, "crop": null, "verbatim": null, "lineage_id": "hw:nal-302-006-w:1", "source": "hw"}, {"mark": "‖", "claim": "Sailed Southampton (1866-06-18)", "citation": "Lloyd's List, 19 June 1866, p