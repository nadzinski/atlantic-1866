{"voyage_id": "V-columbia-660615-63ad84", "claims": [{"mark": "*", "claim": "Cleared New Orleans (15th)", "citation": "New York Herald, 22 June 1866, p. 2, col. 6", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866062201:0186/4773,3220,940,120/640,/0/default.jpg", "verbatim": "Columbia (Brem), Muller, Bremen;", "lineage_id": "herald:Lfa69bafd910808b9", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-06-22/ed-1/seq-2/"}, {"mark": "†", "claim": "Brought news from Vera Cruz, to 1866-07-02", "citation": "New York Herald, 12 July 1866, p. 8, col. 1", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-07-12/ed-1/seq-8/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866071201:0360/192,3151,972,194/640,/0/default.jpg", "verbatim": "We have also received via the\nSolient[?] to Havana and the Columbia to this port corres-\npondence from Vera Cruz to July 2 and the city of\nMexico to June 29.", "lineage_id": "herald:Ld601bb3fe8349bdf", "source": "herald"}, {"mark": "‡", "claim": "Brought news from Havana, to 1866-06-16", "citation": "New York Herald, 21 June 1866, p. 4, col. 6", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-06-21/ed-1/seq-4/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866062101:0180/4828,1501,983,202/640,/0/default.jpg", "verbatim": "The steamship Columbia, Captain Barton, from Ha-\nvana, 16th inst., arrived at this port yesterday. We\nhave to thank the Purser for the early reception of\nour despatches.", "lineage_id": "herald:L5adf17a54ff32243", "source": "herald"}], "aboard": {"specie": [], "passengers": [], "mails": [], "headlines": [{"text": "MEXICO.", "dates_to": "1866-07-02", "marks": ["†"]}, {"text": "CUBA.", "dates_to": "1866-06-16", "marks": ["‡"]}], "mail": []}}