{"voyage_id": "V-lafayette-660504-95fd35", "claims": [{"mark": "*", "claim": "Sailed New York (1866-05-05)", "citation": "New York Herald, 6 May 1866, p. 10, col. 4", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_goldenglow_ver01:data:sn83030313:00271743543:1866050601:1126/3019,6714,966,315/640,/0/default.jpg", "verbatim": "Lafayette,", "lineage_id": "herald:L7ec520385f1824e2", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-05-06/ed-1/seq-10/"}, {"mark": "†", "claim": "Departed New York (5 May)", "citation": "Hubbard & Winter, North Atlantic Mail Sailings 1840-75 (USPCS, 1988; rev. 2014), p. 277", "source_kind": "compiled", "displayable": false, "crop": null, "verbatim": null, "lineage_id": "hw:cgt-287-024-e:0", "source": "hw"}, {"mark": "‡", "claim": "Arrived Le Havre (1866-05-19)", "citation": "New York Herald, 4 June 1866, p. 5, col. 6", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_houseleek_ver01:data:sn83030313:00271743555:1866060401:0043/4637,2641,971,120/640,/0/default.jpg", "verbatim": "HAVRE, May 19—Arr Lafayette (s), Lemaire, NYork;", "lineage_id": "herald:L2f6261f0c14683ca", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-06-04/ed-1/seq-5/"}, {"mark": "§", "claim": "Arrived Le Havre (19 May)", "citation": "Hubbard & Winter, North Atlantic Mail Sailings 1840-75 (USPCS, 1988; rev. 2014), p. 277", "source_kind": "compiled", "displayable": false, "crop": null, "verbatim": null, "lineage_id": "hw:cgt-287-024-e:2", "source": "hw"}, {"mark": "‖", "claim": "Spoken / sighted lat 41 46[?], lon 62 12[?] (8th)", "citation": "New York Herald, 11 May 1866, p. 9, col. 3", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_goldenglow_ver01:data:sn83030313:00271743543:1866051101:1183/1894,2563,980,253/640,/0/default.jpg", "verbatim": "Steamship Napoleon III (Fr), Bocande, Havre April 26,\nand Brest 27th, with mdse and 124 passengers, to Geo\nMackenzie. May 1, 9 PM, lat 48 40, lon 26 21, spoke steam-\nship City of Washington, hence for Liverpool, in tow of\nanother steamer; did not requir e any assistance; wind blow-\ning fresh at the time; 8th, lat 41 46[?], lon 62 12[?], signalized [cut]\nsteamship Lafayette, hence for Havre; 9th, lat 40 46, lon 69\n10, saw ship Constance, bound W.", "lineage_id": "herald:Lef07d48fd967a118", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-05-11/ed-1/seq-9/"}, {"mark": "¶", "claim": "Cleared New York (1866-05-04)", "citation": "New York Herald, 5 May 1866, p. 8, col. 5", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_goldenglow_ver01:data:sn83030313:00271743543:1866050501:1116/3909,2423,959,120/640,/0/default.jpg", "verbatim": "Steamship Lafayette (Fr), Lemaire, Havre—George Mac-\nkenzie.", "lineage_id": "herald:Ld33bf82a028b7586", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-05-05/ed-1/seq-8/"}, {"mark": "7", "claim": "Cleared New York (1866-05-04)", "citation": "The Sun (New York), 5 May 1866, p. 4, col. 3", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:nn:batch_nn_brown_ver01:data:sn83030272:0020653607A:1866050501:0432/1377,2257,709,319/640,/0/default.jpg", "verbatim": "Lafayette Ha-\nvre", "lineage_id": "sun:L7c45ea4d66484722", "source": "sun", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030272/1866-05-05/ed-1/seq-4/"}, {"mark": "8", "claim": "Cleared New York (1866-05-04)", "citation": "New-York Tribune, 5 May 1866, p. 7, col. 2", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_delphi_ver03:data:sn83030214:00206530832:1866050501:0045/1026,2251,1060,120/640,/0/default.jpg", "verbatim": "Steamship Lafayette (Fr.), Lemaire, Havre, Geo. Mackenzie.", "lineage_id": "tribune:L832fc206daea1d0c", "source": "tribune", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030214/1866-05-05/ed-1/seq-7/"}, {"mark": "9", "claim": "Specie $145,600", "citation": "New York Herald, 6 May 1866, p. 4, col. 1", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-05-06/ed-1/seq-4/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_goldenglow_ver01:data:sn83030313:00271743543:1866050601:1120/132,3806,993,366/640,/0/default.jpg", "verbatim": "There was a larger\nexport of treasure than usual to Europe by this day's\nsteamers, the total aggregating $991,515, of which\nabout $600,000 was in bar gold and silver. The Her-\nmann took of this amount $221,300, the Allemania\n$63,000, the City of London $311,000, the Malta $250,615\nand the Lafayette $145,600. The export for the week\nhas been $1,247,240.", "lineage_id": "herald:L632aa9620cf31e90", "source": "herald"}], "aboard": {"specie": [{"text": "$145,600", "marks": ["9"]}], "passengers": [], "mails": [], "headlines": [], "mail": []}}