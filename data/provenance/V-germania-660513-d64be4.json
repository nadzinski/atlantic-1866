{"voyage_id": "V-germania-660513-d64be4", "claims": [{"mark": "*", "claim": "Arrived New York (1866-05-15)", "citation": "New York Herald, 16 May 1866, p. 8, col. 4", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_goldenglow_ver01:data:sn83030313:00271743543:1866051601:1234/2982,6708,982,494/640,/0/default.jpg", "verbatim": "Ship Germania (Pruss), Franke, Rotterdam, 53 days, with\nmdse and 57 passengers, to Chas Luling & Co. March 24, lat\n50, lon 10, spoke ship Bloomer, Flemming, from Cardiff,\nbound to Aden, in distress. (See Disasters.) The G lost\nsails and spars, and had the cabin skylight stove in the same\ngale.", "lineage_id": "herald:L6b717c57bad93af1", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-05-16/ed-1/seq-8/"}, {"mark": "†", "claim": "Arrived New York (yesterday)", "citation": "New York Herald, 16 May 1866, p. 8, col. 5", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_goldenglow_ver01:data:sn83030313:00271743543:1866051601:1234/3904,912,967,120/640,/0/default.jpg", "verbatim": "ship\nGermania, Capt Franke, which arrived at this port yester-\nday from Rotterdam", "lineage_id": "herald:Lce6274c34681d640", "source": "herald", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-05-16/ed-1/seq-8/"}, {"mark": "‡", "claim": "Arrived New York (1866-05-15)", "citation": "The Sun (New York), 16 May 1866, p. 4, col. 3", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:nn:batch_nn_brown_ver01:data:sn83030272:0020653607A:1866051601:0468/1446,974,704,320/640,/0/default.jpg", "verbatim": "Germania, Rotterdam", "lineage_id": "sun:Lcd1cedaf05440d36", "source": "sun", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030272/1866-05-16/ed-1/seq-4/"}, {"mark": "§", "claim": "Arrived New York (1866-05-15)", "citation": "New-York Tribune, 16 May 1866, p. 8, col. 6", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_delphi_ver03:data:sn83030214:00206530832:1866051601:0118/5059,408,1019,366/640,/0/default.jpg", "verbatim": "Ship Germania (Pruss.), Franke, Rotterdam 56[?] days, with mdse. and\n57 pass. to Charles Luling & Co.", "lineage_id": "tribune:Ldcbbc2721bfe443f", "source": "tribune", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030214/1866-05-16/ed-1/seq-8/"}, {"mark": "‖", "claim": "Arrived New York (1866-05-16)", "citation": "New-York Tribune, 17 May 1866, p. 8, col. 5", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_delphi_ver03:data:sn83030214:00206530832:1866051701:0126/4016,3786,1048,120/640,/0/default.jpg", "verbatim": "Ship Germania (Pruss.), Franke, Rotterdam 58 days, with mdse. and\n57 pass. to Charles Luling & Co.", "lineage_id": "tribune:L7c0d2bfb8fe943f4", "source": "tribune", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030214/1866-05-17/ed-1/seq-8/"}, {"mark": "¶", "claim": "Brought news from Liverpool, to 1866-05-01", "citation": "Evening Star (Washington), 14 May 1866, p. 4, col. 1", "url": "https://chroniclingamerica.loc.gov/lccn/sn83045462/1866-05-14/ed-1/seq-4/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_leonberger_ver03:data:sn83045462:00280654267:1866051401:0063/132,441,1031,147/640,/0/default.jpg", "verbatim": "The steamers Germania and City of Paris.\nwith Liverpool dates[?] to the 1st and 2d inst.,\nhave arrived at New York,", "lineage_id": "star:L4ed17ad69b5ed10b", "source": "star"}, {"mark": "7", "claim": "Brought news from Europe, to 1866-05-03", "citation": "New York Herald, 14 May 1866, p. 4, col. 1", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030313/1866-05-14/ed-1/seq-4/", "source_kind": "newspaper", "displayable": true, "crop": "https://tile.loc.gov/image-services/iiif/service:ndnp:dlc:batch_dlc_goldenglow_ver01:data:sn83030313:00271743543:1866051401:1214/216,2398,982,157/640,/0/default.jpg", "verbatim": "By the arrival of the steamships Germania and City of\nParis at this port yesterday we have news from Europe\nto the 3d of May, four days later.", "lineage_id": "herald:L1a9850b58eb24826", "source": "herald"}, {"mark": "8", "claim": "Brought news from Southampton, to 1866-05-02", "citation": "The Sun (New York), 14 May 1866, p. 1, col. 1", "url": "https://chroniclingamerica.loc.gov/lccn/sn83030272/1866-05-14/ed-1/seq-1/", "source_kind": "newspaper", "displayable": true, "crop": null, "verbatim": "NEW YORK, MAY 13th.—The steamship Germania,\nfrom Southampton, on the 2d of May, has arrived at\nthis port.", "lineage_id": "sun:La117fad4687eb35a", "source": "sun"}], "aboard": {"specie": [], "passengers": [{"n": 57, "marks": ["*", "§", "‖"]}], "mails": [], "headlines": [{"text": "LATER FROM EUROPE.", "dates_to": "1866-05-01", "marks": ["¶"]}, {"text": "THE NEWS. EUROPE.", "dates_to": "1866-05-03", "marks": ["7"]}, {"text": "From Europe. Four Days Later News.", "dates_to": "1866-05-02", "marks": ["8"]}], "mail": []}}